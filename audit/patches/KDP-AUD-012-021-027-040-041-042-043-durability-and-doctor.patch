+def configure_sqlite_connection(dbapi_connection, _record=None) -> None:
+    """Per-connection pragmas: enforce declared foreign keys and wait for writers (KDP-AUD-042)."""
+    # Let SQLAlchemy emit BEGIN itself (documented pysqlite pattern) so per-transaction pragmas hold.
+    dbapi_connection.isolation_level = None
+    cursor = dbapi_connection.cursor()
+    try:
+        cursor.execute("PRAGMA foreign_keys=ON")
+        cursor.execute("PRAGMA busy_timeout=15000")
+    finally:
+        cursor.close()
