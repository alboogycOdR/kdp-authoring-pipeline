+def _defer_foreign_keys(connection) -> None:
+    # The ORM flushes rows without relationship() ordering (e.g. approvals before assets), so
+    # constraints are checked at COMMIT rather than per statement; they are still enforced.
+    connection.exec_driver_sql("BEGIN")
+    connection.exec_driver_sql("PRAGMA defer_foreign_keys=ON")
