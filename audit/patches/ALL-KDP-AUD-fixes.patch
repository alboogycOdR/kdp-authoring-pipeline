+++ b/src/kdp_pipeline/storage/relocate.py
@@ -0,0 +1,65 @@
+"""Verified relocation of a restored workspace whose SQLite rows hold absolute paths (KDP-AUD-027).
+
+Rewrites every stored path that starts with ``old_root`` (POSIX or Windows form) so it points under
+``root``; verifies each asset's SHA-256 afterwards; commits only if every rewritten asset verifies;
+records one audit event. Nothing is rewritten when verification fails.
+"""
+from __future__ import annotations
+
+import re
+from pathlib import Path, PureWindowsPath, PurePosixPath
+
+from sqlalchemy import select
+
+from kdp_pipeline.storage.audit import AuditEventWriter
+from kdp_pipeline.storage.db import (AssetRow, CanonProposalRow, EditorialFindingRow, ManuscriptBuildRow)
+from kdp_pipeline.storage.files import sha256_file
+
+
+def _rebase(value: str | None, old_root: str, root: Path) -> str | None:
+    if not value:
+        return value
+    windows = bool(re.match(r"^[A-Za-z]:[\\/]", old_root))
+    old = PureWindowsPath(old_root) if windows else PurePosixPath(old_root)
+    candidate = PureWindowsPath(value) if windows else PurePosixPath(value)
+    try:
+        relative = candidate.relative_to(old) if not windows else PureWindowsPath(
+            str(candidate).lower()).relative_to(PureWindowsPath(str(old).lower()))
+    except ValueError:
+        return None
+    if windows:  # keep original casing of the relative part
+        relative = PureWindowsPath(str(candidate)[len(str(old)):].lstrip("\\/"))
+    return str(root.joinpath(*relative.parts))
+
+
+def relocate_workspace(root: Path, old_root: str, *, actor_id: str = "cli-user", dry_run: bool = False) -> dict:
+    from kdp_pipeline.storage.service import session_scope
+    root = root.resolve()
+    changed: dict[str, int] = {}
+    failures: list[str] = []
+    with session_scope(root) as session:
+        targets = ((AssetRow, ("path", "source_ref")), (ManuscriptBuildRow, ("manifest_path",)),
+                   (EditorialFindingRow, ("snapshot_path",)), (CanonProposalRow, ("snapshot_path",)))
+        for model, fields in targets:
+            for row in session.scalars(select(model)):
+                for field in fields:
+                    new = _rebase(getattr(row, field), old_root, root)
+                    if new is not None and new != getattr(row, field):
+                        setattr(row, field, new)
+                        changed[f"{model.__tablename__}.{field}"] = changed.get(f"{model.__tablename__}.{field}", 0) + 1
+        for asset in session.scalars(select(AssetRow)):
+            path = Path(asset.path)
+            if path.is_relative_to(root) and asset.approval_status != "superseded":
+                if not path.is_file() or sha256_file(path) != asset.sha256:
+                    failures.append(asset.asset_id)
+        summary = {"old_root": old_root, "new_root": str(root), "rewritten": changed,
+                   "verification_failures": failures, "committed": False}
+        if failures or dry_run:
+            session.rollback()
+            return summary
+        AuditEventWriter.append(session, actor_id=actor_id, action="workspace.relocated", entity_type="workspace",
+                                entity_id=str(root), correlation_id=str(root), result="success",
+                                metadata={"old_root": old_root, "rewritten": changed})
+        session.commit()
+        summary["committed"] = True
+        return summary
