[Unit]
Description=KDP Pipeline staging Workspace
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/clawusr/apps/kdp-authoring-pipeline
Environment=KDP_WORKSPACE_OPERATOR_HEADER=Tailscale-User-Login
Environment=KDP_PROVIDER_HOST_ALLOWLIST=api.openai.com
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/home/clawusr/.local/bin/kdp-staging workspace serve --root /home/clawusr/apps/kdp-authoring-pipeline --port 8766
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/clawusr/apps/kdp-authoring-pipeline/.kdp /home/clawusr/apps/kdp-authoring-pipeline/projects
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=default.target
